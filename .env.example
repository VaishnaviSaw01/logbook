# Copy this file to .env and fill in real values before running
# `docker compose up --build`. .env is gitignored — never commit real
# credentials.

# MongoDB Atlas (or any reachable MongoDB) connection string. All five
# backend services share this one database, distinguished by collection.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/logbookDB?retryWrites=true&w=majority

# Any long random string. Must be identical across all five backend
# services — it's what lets a token issued by auth-service be verified
# by customer/inventory/transaction/insights-service.
JWT_SECRET=change-me-to-a-long-random-value

# Optional. Powers the AI Insights tab's business summary and the "Draft
# with AI" reminder messages with real generated text. Get a key at
# https://console.anthropic.com — leave blank and those features still
# work, just with rule-based text instead of AI-generated text.
ANTHROPIC_API_KEY=
