# Copy this file to .env and fill in real values before running
# `docker compose up --build`. .env is gitignored — never commit real
# credentials.

# MongoDB Atlas (or any reachable MongoDB) connection string. All four
# backend services share this one database, distinguished by collection.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/logbookDB?retryWrites=true&w=majority

# Any long random string. Must be identical across all four backend
# services — it's what lets a token issued by auth-service be verified
# by customer/inventory/transaction-service.
JWT_SECRET=change-me-to-a-long-random-value
